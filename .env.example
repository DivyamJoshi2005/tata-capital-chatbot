# ==========================================
# Tata Capital Chatbot Configuration
# ==========================================

# Choose LLM Provider: 'ollama' (Free Local) or 'groq' (Cloud API)
# Defaults to 'ollama' if GROQ_API_KEY is not set.
LLM_PROVIDER=ollama

# ------------------------------------------
# Local Ollama Settings (100% Free, No API Key)
# ------------------------------------------
# Recommended reasoning models for local execution:
# - llama3.2:3b        (Default: Meta Llama 3.2 3B, ~2.0 GB, fast reasoning on CPU)
# - deepseek-r1:1.5b   (DeepSeek R1 Chain-of-Thought reasoning, ~1.1 GB)
# - deepseek-r1:8b     (DeepSeek R1 on Llama 8B, ~4.9 GB)
# - llama3.1:8b        (Full Llama 3.1 8B parameter model, ~4.7 GB)
# - qwen2.5:3b         (Qwen 2.5 3B, ~1.9 GB)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------
# Cloud Groq Settings (Optional)
# ------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
